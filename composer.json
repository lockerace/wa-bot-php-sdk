{
  "name": "lockerace/wa-bot-sdk",
  "type": "library",
  "license": "MIT",
  "autoload": {
    "psr-4": {
      "Lockerace\\WaBot\\": "src/"
    }
  },
  "authors": [
    {
      "name": "Ace Locker",
      "email": "lockerace@gmail.com"
    }
  ],
  "minimum-stability": "dev",
  "prefer-stable": true,
  "require": {
    "php": "^8.1"
  },
  "require-dev": {
    "phpunit/phpunit": "^11.5"
  },
  "config": {
    "sort-packages": true,
    "preferred-install": "dist",
    "optimize-autoloader": true
  },
  "extra": {
    "laravel": {
      "providers": [
        "Lockerace\\WaBot\\WaBotServiceProvider"
      ]
    }
  }
}
